<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Talking to paisense.onrender.com. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Reading the inbox for history, and catching messages as they arrive.
         Both are restricted permissions: Google only allows them for apps
         whose core function is SMS handling, so PaiSense can never go on the
         Play Store. Sideloaded APKs are unaffected. See ADR 001 and 027. -->
    <uses-permission android:name="android.permission.READ_SMS" />
    <uses-permission android:name="android.permission.RECEIVE_SMS" />

    <!-- Android 13+ requires asking before an app may post notifications.
         Without it the import worker runs silently and looks like nothing
         is happening. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- The import runs as a foreground service so Android doesn't kill it
         mid-way. Asking WorkManager for a dataSync service without declaring
         it here crashes on start with "foregroundServiceType 0x1 is not a
         subset of 0x0". -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.PaiSense">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.PaiSense"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- WorkManager declares this service itself; merging adds the type
             our worker asks for. tools:node="merge" edits the existing entry
             rather than declaring a competing one. -->
        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            android:foregroundServiceType="dataSync"
            tools:node="merge" />
    </application>

</manifest>