# Secrets — NEVER commit these. The whole point of .env is that it stays local.
.env
.env.*
!.env.example

# Python
.venv/
__pycache__/
*.pyc

# Node / Expo (for the app, later phases)
node_modules/
.expo/
dist/

# Editor / OS noise
.vs/
.vscode/
.idea/
.DS_Store
Thumbs.db

# Local chat archives — personal record, never push
chat-archive/

# Android / Gradle
android/.gradle/
android/build/
android/app/build/
android/captures/
android/.idea/
android/.cxx/
# Contains the absolute path to YOUR Android SDK - machine-specific, and it
# breaks the build on any other machine if committed.
android/local.properties
*.apk
*.aab
*.keystore
*.jks
