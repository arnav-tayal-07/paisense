# Copy this file to .env and fill in real values. .env is git-ignored; this example is committed.
DATABASE_URL=postgresql://postgres.PROJECT-REF:DB-PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# Gemini API key from https://aistudio.google.com — free tier (ADR 019)
GEMINI_API_KEY=your-key-here

# Optional: override the model. Check aistudio.google.com for current names.
# GEMINI_MODEL=gemini-3.6-flash

# Optional: pin one model, or override the whole fallback chain.
# Each model has its OWN free-tier daily quota, so the chain multiplies headroom.
# GEMINI_MODEL=gemini-3.1-flash-lite
# GEMINI_MODELS=gemini-3.1-flash-lite,gemini-3.5-flash-lite,gemini-3.5-flash

# Shared API key - one secret meaning 'this request came from my phone'.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
PAISENSE_API_KEY=generate-your-own
