# Copy this file to .env and fill in real values. .env is git-ignored; this example is committed.
DATABASE_URL=postgresql://postgres.PROJECT-REF:DB-PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# Gemini API key from https://aistudio.google.com — free tier (ADR 019)
GEMINI_API_KEY=your-key-here

# Optional: override the model. Check aistudio.google.com for current names.
# GEMINI_MODEL=gemini-3.6-flash
